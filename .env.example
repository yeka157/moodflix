# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SECRET_KEY=

# Database (pooler for runtime queries, port 6543)
DATABASE_URL=

# Direct connection for Drizzle Kit migrations (port 5432, no pgBouncer)
DATABASE_URL_DIRECT=

# TMDB
TMDB_API_READ_KEY=

# Google AI (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron auth for the daily release-alert job
CRON_SECRET=
